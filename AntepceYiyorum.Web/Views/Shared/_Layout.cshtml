<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Antepçe Yiyorum | Gaziantep Yöresel Lezzetleri</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Üst Bilgilendirme Bandı -->
    <div class="top-announcement">
        <div class="container top-announcement-inner">
            <span>🌿 Gaziantep'ten Doğrudan Sofranıza Doğal &amp; Katkısız Yöresel Ürünler</span>
            <span class="top-badge">Güvenli Alışveriş • Hızlı Gönderim</span>
        </div>
    </div>

    <!-- Ana Navigasyon -->
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">🥜</span>
                <div class="brand-text">
                    <strong>Antepçe Yiyorum</strong>
                    <small>Gaziantep Yöresel Pazarı</small>
                </div>
            </a>

            <nav class="main-nav">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">Ana Sayfa</a>
                <a href="/#kategoriler" class="nav-link">Kategoriler</a>
                <a href="/#one-cikanlar" class="nav-link">Yöresel Ürünler</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link nav-admin-badge">
                        ⚙️ Yönetim Paneli (Admin)
                    </a>
                }
            </nav>

            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm">
                            📦 Fiyat / Stok / Fotoğraf Yönet
                        </a>
                    }
                    <span class="user-greeting">👤 @User.Identity.Name</span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-outline btn-sm">Çıkış</button>
                    </form>
                }
                else
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline btn-sm" title="Yönetici girişi yaparak Admin Paneline geçin">
                        ⚙️ Admin Paneli
                    </a>
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                        Giriş Yap
                    </a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-outline btn-sm">
                        Üye Ol
                    </a>
                }

                <span class="cart-pill" title="Sepet">
                    🛒 Sepet <span class="cart-count">0</span>
                </span>
            </div>
        </div>
    </header>

    <!-- Sayfa İçeriği -->
    <main role="main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container" style="margin-top:1rem;">
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Alt Bilgi (Footer) -->
    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <h3>Antepçe Yiyorum</h3>
                <p>Gaziantep'in fıstığını, ipek pul biberini, güneş kurusu salçasını ve asırlık mutfak kültürünü yerel üreticilerden doğrudan sofranıza ulaştırıyoruz.</p>
            </div>
            <div class="footer-meta">
                <p>&copy; @DateTime.Now.Year - Antepçe Yiyorum E-Ticaret Platformu</p>
                <p>
                    <small>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Yönetim Paneli</a> •
                        REST API: <a href="/api/v1/health" target="_blank">/api/v1/health</a>
                    </small>
                </p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
