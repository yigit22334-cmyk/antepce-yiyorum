@model AntepceYiyorum.Web.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-header">
                <span class="auth-icon">🔑</span>
                <h1>Şifre Sıfırlama</h1>
                <p>Kayıtlı e-posta adresinizi girin, şifre sıfırlama bağlantısı oluşturalım</p>
            </div>

            @if (ViewBag.ConfirmationSent == true)
            {
                <div class="alert alert-success">
                    Eğer bu e-posta adresi sistemimizde kayıtlıysa, şifre sıfırlama bağlantısı oluşturulmuştur.
                    @if (ViewBag.DemoResetLink != null)
                    {
                        <hr style="margin: 0.75rem 0; border-color: rgba(0,0,0,0.1);" />
                        <p><strong>Geliştirme Ortamı Sıfırlama Bağlantısı:</strong></p>
                        <p><a href="@ViewBag.DemoResetLink" class="btn btn-primary" style="margin-top:0.5rem;">Yeni Şifre Belirle</a></p>
                    }
                </div>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@eposta.com" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Sıfırlama Bağlantısı Oluştur</button>
                </form>
            }

            <div class="auth-footer">
                <p><a asp-action="Login">&larr; Giriş Sayfasına Dön</a></p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
