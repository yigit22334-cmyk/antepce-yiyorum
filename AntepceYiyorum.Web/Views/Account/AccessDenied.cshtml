@{
    ViewData["Title"] = "Erişim Engellendi";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card" style="text-align:center;">
            <span class="auth-icon">⛔</span>
            <h1>Bu Sayfaya Erişim Yetkiniz Yok</h1>
            <p style="margin: 1rem 0 1.5rem; color: var(--color-text-muted);">
                Yönetim Paneli (Admin) sayfalarına erişebilmek için <strong>Admin</strong> yetkisine sahip bir hesapla giriş yapmanız gerekmektedir.
            </p>
            <div style="display:flex; gap:0.75rem; justify-content:center;">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline">Ana Sayfaya Dön</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Farklı Hesapla Giriş Yap</a>
            </div>
        </div>
    </div>
</section>
