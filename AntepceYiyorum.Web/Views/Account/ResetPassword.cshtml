@model AntepceYiyorum.Web.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-header">
                <span class="auth-icon">🔒</span>
                <h1>Yeni Şifre Belirle</h1>
                <p>@Model.Email hesabınız için yeni şifrenizi girin</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="auth-form">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Şifremi Güncelle</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
